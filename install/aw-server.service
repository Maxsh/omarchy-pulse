[Unit]
Description=ActivityWatch server (aw-server-rust)
Documentation=https://activitywatch.net
PartOf=graphical-session.target
After=graphical-session.target

[Service]
# The AUR package activitywatch-bin bundles both server flavors, but its XDG
# autostart only manages aw-qt (tray), which can't run on Omarchy (no system
# tray), so we supervise the bundled aw-server-rust directly.
# First start auto-imports the legacy Python datastore
# (~/.local/share/activitywatch/aw-server/) into aw-server-rust/.
ExecStart=/usr/bin/aw-server-rust
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=graphical-session.target
